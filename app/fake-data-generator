"use client";
import { useState } from "react";

const firstNames = ["Aarav","Vihaan","Advik","Sai","Arjun","Reyansh","Mohammad","Ayaan","Krishna","Ishaan","Ananya","Diya","Saanvi","Anika","Sara","Pari","Myra","Aadhya"];
const lastNames = ["Sharma","Verma","Gupta","Singh","Yadav","Kumar","Patel","Jaiswal","Mishra","Tiwari"];
const cities = ["Mumbai","Delhi","Lucknow","Bangalore","Pune","Jaipur","Kolkata","Hyderabad","Ayodhya"];
const companies = ["TechNova","InnovateX","Future Labs","DigitalCraft","WebSprint","CodeSquad"];

export default function FakeDataGenerator() {
  const [data, setData] = useState(generateData());

  function generateData() {
    const fn = firstNames[Math.floor(Math.random() * firstNames.length)];
    const ln = lastNames[Math.floor(Math.random() * lastNames.length)];
    return {
      name: `${fn} ${ln}`,
      email: `${fn.toLowerCase()}.${ln.toLowerCase()}${Math.floor(Math.random()*99)}@gmail.com`,
      phone: `+91 9${Math.floor(100000000 + Math.random()*900000000)}`,
      address: `${Math.floor(Math.random()*500)} ${cities[Math.floor(Math.random()*cities.length)]}, UP, India`,
      company: companies[Math.floor(Math.random()*companies.length)],
      bio: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
      avatar: `https://api.dicebear.com/7.x/avataaars/svg?seed=${fn}${ln}${Date.now()}`
    };
  }

  const handleGenerate = () => setData(generateData());

  const handleCopy = (text) => {
    navigator.clipboard.writeText(text);
    alert("Copied: " + text);
  };

  const handleExportJSON = () => {
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = "fake-data.json"; a.click();
  };

  return (
    <div className="min-h-screen bg-[#f8f9fb] text-gray-800 p-6 md:p-12 font-sans">
      <div className="max-w-4xl mx-auto">
        <div className="text-center mb-10">
          <span className="bg-black text-white text-xs px-3 py-1 rounded-full">MONSTER TOOL 1</span>
          <h1 className="text-4xl font-bold mt-4 tracking-tight">Ultimate Fake Data Generator</h1>
          <p className="text-gray-500 mt-2">Generate realistic fake profiles for design, testing & development in 1 click.</p>
        </div>

        <div className="grid md:grid-cols-3 gap-6">
          <div className="md:col-span-1 bg-white border border-gray-200 rounded-2xl p-6 text-center shadow-sm">
            <img src={data.avatar} alt="avatar" className="w-24 h-24 mx-auto rounded-full bg-gray-100 mb-4" />
            <h2 className="font-bold text-lg">{data.name}</h2>
            <p className="text-sm text-gray-500">{data.company}</p>
            <button onClick={handleGenerate} className="w-full mt-6 bg-black text-white py-3 rounded-xl font-semibold hover:bg-gray-800 transition">Generate New →</button>
            <button onClick={handleExportJSON} className="w-full mt-3 bg-white border border-gray-300 py-3 rounded-xl font-semibold hover:bg-gray-50 transition">Export JSON</button>
          </div>

          <div className="md:col-span-2 bg-white border border-gray-200 rounded-2xl p-6 shadow-sm space-y-4">
            {Object.entries(data).filter(([k])=>k!=='avatar').map(([key, value])=>(
              <div key={key} className="flex justify-between items-center p-4 bg-[#f8f9fb] rounded-xl border border-gray-100">
                <div>
                  <p className="text-[11px] uppercase tracking-widest text-gray-400 font-bold">{key}</p>
                  <p className="font-medium mt-1 text-gray-800">{value}</p>
                </div>
                <button onClick={()=>handleCopy(value)} className="text-xs bg-white border px-3 py-1.5 rounded-lg hover:bg-gray-100">Copy</button>
              </div>
            ))}
          </div>
        </div>

        <p className="text-center text-xs text-gray-400 mt-8">Made for developers • No data stored • Free forever • <a href="https://lorem-pro-tool.vercel.app" className="underline">lorem-pro-tool.vercel.app</a></p>
      </div>
    </div>
  );
}
